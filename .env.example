LISTEN_ADDR=:8080
JWT_SECRET=please-change-me-to-32-random-chars-minimum
DB_PATH=./data/atoms.db

# LLM provider. Auto-detected if unset. Values: "claude" | "openai" | "mock"
# - "claude": Anthropic Messages API (https://docs.anthropic.com/en/api/messages)
# - "openai": OpenAI Chat Completions API (also works with OpenAI-compatible proxies)
# - "mock":   canned responses, no network call
# Auto-detection: base URL containing "anthropic" or key starting with "sk-ant-" → claude
LLM_PROVIDER=claude

# API key. New name; OPENAI_API_KEY is also accepted as a legacy alias.
LLM_API_KEY=sk-ant-your-key-here

# Endpoint. Default for claude: https://api.anthropic.com
# Default for openai: https://api.openai.com/v1
LLM_BASE_URL=https://api.anthropic.com

# Model name. Sensible defaults:
#   claude -> claude-3-5-sonnet-20241022
#   openai -> gpt-4o-mini
LLM_MODEL=claude-3-5-sonnet-20241022
